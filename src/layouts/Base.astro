---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsApp from '../components/WhatsApp.astro';

const { title, description, lang = 'en' } = Astro.props;
const path = Astro.url.pathname.replace(/^\/(en|fi|sv)/, '') || '/';
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | Foundation Clinic</title>
  {description && <meta name="description" content={description} />}
  <meta property="og:title" content={`${title} | Foundation Clinic`} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={`https://foundation.clinic/${lang !== 'en' ? lang + '/' : ''}`} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://foundation.clinic/assets/images/hero-bg.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="alternate" hreflang="en" href={`https://foundation.clinic/en${path}`} />
  <link rel="alternate" hreflang="fi" href={`https://foundation.clinic/fi${path}`} />
  <link rel="alternate" hreflang="sv" href={`https://foundation.clinic/sv${path}`} />
  <link rel="alternate" hreflang="x-default" href={`https://foundation.clinic/en${path}`} />
  <link rel="stylesheet" href="/assets/css/style.css" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
</head>
<body>
  <Nav lang={lang} />
  <slot />
  <Footer lang={lang} />
  <WhatsApp lang={lang} />
</body>
</html>