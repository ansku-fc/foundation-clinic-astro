---
import Base from '../layouts/Base.astro';
---
<Base title="Contact" description="Get in touch with Foundation Clinic.">

  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Contact</span>
      <h1>Let's talk about your health.</h1>
      <p class="lead" style="margin-top: 16px;">We answer all emails within 24 hours.</p>
    </div>
  </section>

  <section class="section-ivory">
    <div class="container">
      <div class="split fade-up">
        <div>
          <span class="eyebrow">Send us a message</span>
          <h2 style="margin-bottom: 32px;">Get in touch.</h2>
          <form class="contact-form" action="https://formspree.io/f/hello@foundation.clinic" method="POST">
            <div class="form-row">
              <div class="form-group">
                <label for="first-name">First name</label>
                <input type="text" id="first-name" name="first_name" placeholder="Anna" required />
              </div>
              <div class="form-group">
                <label for="last-name">Last name</label>
                <input type="text" id="last-name" name="last_name" placeholder="Virtanen" required />
              </div>
            </div>
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" placeholder="anna@example.com" required />
            </div>
            <div class="form-group">
              <label for="phone">Phone (optional)</label>
              <input type="tel" id="phone" name="phone" placeholder="+358 40 123 4567" />
            </div>
            <div class="form-group">
              <label for="interest">I'm interested in</label>
              <select id="interest" name="interest">
                <option value="">Select an option</option>
                <option value="membership">Becoming a member</option>
                <option value="family">Family membership</option>
                <option value="corporate">Corporate / partner inquiry</option>
                <option value="other">Something else</option>
              </select>
            </div>
            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" placeholder="Tell us a bit about what you're looking for..."></textarea>
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">Send message</button>
            <p style="font-size: var(--caption); color: var(--fg-3); margin-top: 12px; text-align: center;">We'll get back to you within 24 hours.</p>
          </form>
        </div>
        <div style="display: flex; flex-direction: column; gap: 16px;">
          <span class="eyebrow">Direct contact</span>
          <div style="padding: 20px 24px; background: var(--bg-surface); border: 1px solid var(--t-15); border-radius: var(--radius-lg);">
            <p style="font-size: var(--caption); font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--fg-3); margin-bottom: 6px;">Email</p>
            <a href="mailto:hello@foundation.clinic" style="font-size: var(--body); color: var(--teal); font-weight: 500;">hello@foundation.clinic</a>
          </div>
          <div style="padding: 20px 24px; background: var(--bg-surface); border: 1px solid var(--t-15); border-radius: var(--radius-lg);">
            <p style="font-size: var(--caption); font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--fg-3); margin-bottom: 6px;">Phone</p>
            <a href="tel:+358407268383" style="font-size: var(--body); color: var(--fg-1); font-weight: 500;">+358 40 726 8383</a>
          </div>
          <div style="padding: 20px 24px; background: var(--bg-surface); border: 1px solid var(--t-15); border-radius: var(--radius-lg);">
            <p style="font-size: var(--caption); font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--fg-3); margin-bottom: 6px;">Address</p>
            <p style="font-size: var(--body); color: var(--fg-1);">Ratakatu 29 a 4<br>00120 Helsinki, Finland</p>
          </div>
          <div style="padding: 20px 24px; background: var(--bg-surface); border: 1px solid var(--t-15); border-radius: var(--radius-lg);">
            <p style="font-size: var(--caption); font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--fg-3); margin-bottom: 6px;">Hours</p>
            <p style="font-size: var(--body); color: var(--fg-1);">Monday – Friday<br>9:00 – 17:00</p>
          </div>
        </div>
      </div>
    </div>
  </section>

</Base>