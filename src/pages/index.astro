---
import Base from '../layouts/Base.astro';
---
<Base title="Personal Medical Care" description="Experience continuous, dedicated medical care tailored to you.">

  <section class="hero-fullbleed">
    <div class="hero-bg" style="background-image: url('/assets/images/hero-bg.jpg');"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="hero-eyebrow">Ratakatu 29 a 4 · Helsinki</p>
      <h1 class="hero-headline">Your personal doctor<br>who knows you by name.</h1>
      <p class="hero-lead">Personalised, high-quality, and prevention-first care.<br>Always available, in Finland and abroad.</p>
      <div class="hero-cta">
        <a href="/contact" class="btn hero-btn-primary">Start your care</a>
        <a href="/our-approach" class="btn hero-btn-outline">How it works</a>
      </div>
    </div>
  </section>

  <section class="section-ivory">
    <div class="container">
      <div class="text-center fade-up" style="margin-bottom: 64px;">
        <span class="eyebrow">Our approach</span>
        <h2>Great care starts with a doctor who knows you.</h2>
        <p class="lead" style="margin-top: 16px;">Most people have never had a doctor who truly knows them. At Foundation, one doctor takes full responsibility — from everyday acute appointments to preventive care and specialist coordination.</p>
      </div>
      <div class="card-grid">
        <div class="card fade-up">
          <div style="font-size: 1.5rem; margin-bottom: 16px;">⬡</div>
          <h4 style="margin-bottom: 8px;">Membership model</h4>
          <p style="font-size: var(--body-sm);">Guaranteed access to your doctor, data-driven prevention, and seamless coordination of care — instead of isolated appointments.</p>
        </div>
        <div class="card fade-up" style="animation-delay: 0.08s">
          <div style="font-size: 1.5rem; margin-bottom: 16px;">⬡</div>
          <h4 style="margin-bottom: 8px;">Coordinated care</h4>
          <p style="font-size: var(--body-sm);">Specialist referrals, diagnostics, and treatment decisions brought together in one coherent plan by your dedicated doctor.</p>
        </div>
        <div class="card fade-up" style="animation-delay: 0.16s">
          <div style="font-size: 1.5rem; margin-bottom: 16px;">⬡</div>
          <h4 style="margin-bottom: 8px;">Care anywhere</h4>
          <p style="font-size: var(--body-sm);">Clinic visits, remote appointments, home visits, and international care coordination — healthcare that fits around your life.</p>
        </div>
        <div class="card fade-up" style="animation-delay: 0.24s">
          <div style="font-size: 1.5rem; margin-bottom: 16px;">⬡</div>
          <h4 style="margin-bottom: 8px;">Your medical data</h4>
          <p style="font-size: var(--body-sm);">All your history, lab results, and consultations in one continuous record — so you never have to tell your story from the beginning again.</p>
        </div>
      </div>
      <div style="text-align: center; margin-top: 48px;">
        <a href="/our-approach" class="btn btn-outline">Learn about our approach</a>
      </div>
    </div>
  </section>

  <section class="section-sunken">
    <div class="container">
      <div class="fade-up" style="margin-bottom: 64px;">
        <span class="eyebrow">Services</span>
        <h2>Health for your whole life.</h2>
        <p class="lead" style="margin-top: 16px; max-width: 560px;">Patients come to us for different reasons, but they share one need: a doctor who understands their health in context and follows their care over time.</p>
      </div>
      <div class="split fade-up" style="margin-bottom: 80px;">
        <div class="split-image">
          <img src="https://cdn.prod.website-files.com/67812a141d8f2465fe6175eb/6971fab5aaba75a1d791e909_oleg-kukharuk-pU2XzuGa9ro-unsplash%20(1).jpg" alt="Performance and prevention" />
        </div>
        <div class="split-content">
          <span class="eyebrow">Performance & prevention</span>
          <h3>Staying healthy, staying ahead.</h3>
          <p>Through regular consultations, laboratory testing, and ongoing monitoring, we identify early changes and manage risks proactively.</p>
          <a href="/our-services" class="btn btn-ghost" style="margin-top: 24px;">Learn more</a>
        </div>
      </div>
      <div class="split reverse fade-up">
        <div class="split-image">
          <img src="https://cdn.prod.website-files.com/67812a141d8f2465fe6175eb/69c1164b3d23e55291cebba7_foundation-clinic-who11.webp" alt="Children and families" />
        </div>
        <div class="split-content">
          <span class="eyebrow">Children & families</span>
          <h3>One doctor for you and your whole family.</h3>
          <p>We support families with both preventive care and everyday medical concerns, complementing Finland's neuvola system.</p>
          <a href="/our-services" class="btn btn-ghost" style="margin-top: 24px;">Learn more</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-ivory">
    <div class="container">
      <div class="text-center fade-up" style="margin-bottom: 64px;">
        <span class="eyebrow">Memberships</span>
        <h2>Relationship for the long term.</h2>
      </div>
      <div class="pricing-grid">
        <div class="pricing-card fade-up">
          <div class="pricing-tier">Tier 1</div>
          <div class="price">€99</div>
          <div class="price-label">per month</div>
          <ul class="pricing-features">
            <li>Named doctor, 9am–5pm Mon–Fri</li>
            <li>Prescription renewals</li>
            <li>1 remote consultation / month</li>
            <li>Influenza vaccination</li>
          </ul>
          <a href="/contact" class="btn btn-outline" style="width: 100%; justify-content: center;">Get started</a>
        </div>
        <div class="pricing-card featured fade-up" style="animation-delay: 0.08s">
          <div class="pricing-tier">Tier 2</div>
          <div class="price">€199</div>
          <div class="price-label">per month</div>
          <ul class="pricing-features">
            <li>Named doctor, 9am–5pm Mon–Fri</li>
            <li>Annual health review</li>
            <li>3 remote consultations / month</li>
            <li>1 in-person consultation / month</li>
            <li>Referrals & care coordination</li>
          </ul>
          <a href="/contact" class="btn" style="width: 100%; justify-content: center; background: var(--cream); color: var(--espresso);">Get started</a>
        </div>
        <div class="pricing-card fade-up" style="animation-delay: 0.16s">
          <div class="pricing-tier">Tier 3</div>
          <div class="price">€399</div>
          <div class="price-label">per month</div>
          <ul class="pricing-features">
            <li>Named doctor, 9am–5pm Mon–Fri</li>
            <li>Biannual health reviews</li>
            <li>5 remote consultations / month</li>
            <li>3 in-person consultations / month</li>
            <li>Referrals & care coordination</li>
            <li>External invoice management</li>
          </ul>
          <a href="/contact" class="btn btn-outline" style="width: 100%; justify-content: center;">Get started</a>
        </div>
        <div class="pricing-card fade-up" style="animation-delay: 0.24s">
          <div class="pricing-tier">Children</div>
          <div class="price">€49</div>
          <div class="price-label">per month</div>
          <ul class="pricing-features">
            <li>Named doctor, 9am–5pm Mon–Fri</li>
            <li>2 remote consultations / month</li>
            <li>Influenza vaccination</li>
          </ul>
          <a href="/contact" class="btn btn-outline" style="width: 100%; justify-content: center;">Get started</a>
        </div>
      </div>
      <p style="font-size: var(--body-sm); color: var(--fg-3); margin-top: 24px; text-align: center;">Onboarding consultation €599. <a href="/memberships" style="color: var(--fg-2); text-decoration: underline;">Full details →</a></p>
    </div>
  </section>

  <section class="section-espresso">
    <div class="container">
      <div class="text-center fade-up" style="max-width: 600px; margin: 0 auto;">
        <h2>Contact us to explore how we can support your long-term health.</h2>
        <p style="margin-top: 16px; margin-bottom: 32px;">We answer all emails within 24 hours.</p>
        <a href="/contact" class="btn" style="background: var(--cream); color: var(--espresso);">Get in touch</a>
      </div>
    </div>
  </section>

</Base>