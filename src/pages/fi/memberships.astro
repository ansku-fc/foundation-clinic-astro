---
import Base from '../../layouts/Base.astro';
---
<Base title="Jäsenyydet" description="Pitkäjänteistä terveydenhuoltoa ihmissuhteiden pohjalta." lang="fi">

<style is:global>
  .hero-subpage .hero-overlay {
    background: linear-gradient(to top, rgba(46,31,20,0.87) 0%, rgba(46,31,20,0.55) 50%, rgba(46,31,20,0.25) 100%);
  }
  .lab-tag {
    font-size: 11px !important;
    padding: 3px 7px !important;
  }
  .pkg-row {
    padding: 10px 14px !important;
  }
  .pkg-row span {
    font-size: 12px !important;
  }
  @media (max-width: 768px) {
  .membership-onboarding-grid {
    grid-template-columns: 1fr !important;
    gap: 40px !important;
  }
  .membership-services-grid {
    grid-template-columns: 1fr !important;
    gap: 40px !important;
  }
  .membership-services-image {
    display: none;
  }
}
@media (max-width: 768px) {
  .service-card-inner {
    grid-template-columns: 1fr !important;
    gap: 12px !important;
  }
  .service-card-price {
    text-align: left !important;
  }
}
@media (max-width: 768px) {
  .service-card-price br {
    display: none;
  }
}
@media (max-width: 768px) {
  .tailored-cta {
    margin: 0 !important;
  }
}
  /* Drawer */
  .price-drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(46,31,20,0.35);
    z-index: 998;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .price-drawer-overlay.open {
    opacity: 1;
    pointer-events: all;
  }
  .price-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 520px;
    max-width: 95vw;
    background: #FDFAF7;
    z-index: 999;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
    display: flex;
    flex-direction: column;
    box-shadow: -8px 0 40px rgba(46,31,20,0.12);
  }
  .price-drawer.open {
    transform: translateX(0);
  }
  .price-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28px 32px 20px;
    border-bottom: 1px solid #E7DCCD;
    flex-shrink: 0;
  }
  .price-drawer-header h2 {
    font-family: 'Belleza', Georgia, serif;
    font-size: 1.4rem;
    color: #2E1F14;
    margin: 0;
  }
  .price-drawer-close {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    background: #F2E8D9;
    border: none;
    cursor: pointer;
    color: #2E1F14;
    font-size: 18px;
    transition: background 0.15s ease;
  }
  .price-drawer-close:hover { background: #E7DCCD; }
  .price-drawer-body {
    overflow-y: auto;
    flex: 1;
    padding: 16px 32px 40px;
  }
  /* Accordion */
  .drawer-section {
    border-bottom: 1px solid #E7DCCD;
  }
  .drawer-section-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: 'Belleza', Georgia, serif;
    font-size: 1rem;
    color: #2E1F14;
  }
  .drawer-section-btn:hover { color: #5A3E2B; }
  .drawer-section-chevron {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    transition: transform 0.2s ease;
    color: #8C7866;
  }
  .drawer-section-btn.open .drawer-section-chevron {
    transform: rotate(180deg);
  }
  .drawer-section-content {
    display: none;
    padding-bottom: 16px;
  }
  .drawer-section-content.open { display: block; }
  /* Tables */
  .drawer-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
    margin-top: 8px;
  }
  .drawer-table th {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8C7866;
    padding: 6px 8px;
    text-align: left;
    border-bottom: 1px solid #E7DCCD;
  }
  .drawer-table td {
    padding: 8px 8px;
    color: #5A4736;
    border-bottom: 1px solid #F2E8D9;
    vertical-align: middle;
    font-family: 'Plus Jakarta Sans', sans-serif;
    line-height: 1.5;
    text-align: left;
  }
  .drawer-table tr:last-child td { border-bottom: none; }
  .drawer-td-price {
    text-align: right;
    font-weight: 500;
    color: #2E1F14;
    white-space: nowrap;
  }
  .drawer-note {
    font-size: 11px;
    color: #8C7866;
    line-height: 1.6;
    margin-top: 10px;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
  .drawer-subtitle {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8C7866;
    margin: 16px 0 6px;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
  .drawer-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 8px 0;
    border-bottom: 1px solid #F2E8D9;
    gap: 16px;
  }
  .drawer-row:last-child { border-bottom: none; }
  .drawer-row-label {
    font-size: 12px;
    color: #5A4736;
    font-family: 'Plus Jakarta Sans', sans-serif;
    line-height: 1.5;
    flex: 1;
  }
  .drawer-row-price {
    font-size: 12px;
    font-weight: 500;
    color: #2E1F14;
    font-family: 'Plus Jakarta Sans', sans-serif;
    white-space: nowrap;
    flex-shrink: 0;
  }
</style>

<section class="hero-subpage">
  <div class="hero-bg" style="background-image: url('/assets/images/stilllife-quince.jpg');"></div>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <span class="hero-eyebrow">Jäsenyys</span>
    <h1 class="hero-headline">Tärkein jäsenyytesi.</h1>
    <p class="hero-lead">Nopea, helppo ja taattu pääsy lääkärille, joka tuntee sinut.</p>
  </div>
</section>

<section class="section-cream">
  <div class="container">
    <div class="fade-up membership-onboarding-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start;">
      <div>
        <span class="eyebrow">Alkukartoitus</span>
        <h2 style="margin-bottom: var(--s-4);">Kokonaisvaltaista hoitoa ensitapaamisesta alkaen.</h2>
        <p style="margin-top: 16px;">Alkukartoituksessa käymme läpi terveyshistoriasi, huolesi ja tavoitteesi. Kahden viikon kuluessa sinut kutsutaan seurantakäynnille, jossa lääkärisi käy läpi henkilökohtaisen terveyssuunnitelmasi seuraavalle 6–12 kuukaudelle.</p>
        <div style="margin-top: 28px; background: var(--espresso); border-radius: var(--radius-lg); padding: var(--s-8);">
          <div style="display: flex; align-items: baseline; gap: 12px; margin-bottom: var(--s-2);">
            <span style="font-family: var(--font-display); font-size: 2.4rem; color: var(--cream);">€599</span>
            <span style="font-size: var(--body-sm); color: var(--t-50);">Alkukartoitus</span>
          </div>
          <p style="font-size: var(--caption); color: var(--t-30); line-height: 1.7;">Sisältää kattavan lääkärin haastattelun ja terveyshistorian läpikäynnin, EKG:n, spirometrian, dermatoskopian, laajan laboratoriopaketin, henkilökohtaisen terveyssuunnitelman sekä suunnitelman läpikäynnin lääkärin kanssa.</p>
        </div>
      </div>
      <div style="display: flex; flex-direction: column; gap: var(--s-6);">
        <div>
          <span class="eyebrow">Alkukartoitukseen kuuluvat laboratoriokokeet</span>
          <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: var(--s-3);">
            {['Chol', 'Trig', 'LDL-C', 'HDL-C', 'non-HDL', 'ESR', 'ALT', 'ALP', 'AST', 'Bili', 'GGT', 'Crea', 'eGFR', 'CysC', 'Na', 'K', 'Hb', 'WBC', 'Plt', 'MCV', 'MCH', 'RDW', 'RBC', 'sTfR', 'Ferritin', 'Alb', '25-OH-D', 'B12', 'TSH', 'HbA1c', 'fP-Gluc', 'Ca'].map(test => (
              <span class="lab-tag" style="color: var(--fg-2); background: var(--bg-sunken); border: 1px solid var(--t-15); border-radius: var(--radius-sm);">{test}</span>
            ))}
          </div>
        </div>
        <div>
          <span class="eyebrow">Laajennetut laboratoriopaketit</span>
          <div style="display: flex; flex-direction: column; gap: 6px; margin-top: var(--s-3);">
            <div>
  <div style="display: flex; flex-direction: column; gap: 6px; margin-top: var(--s-3);">
    {[
      { name: 'Alkukartoitus, laajennettu', price: '€199', tests: 'Lp(a) · Apolipoproteiinit A1 & B · Herkkä-CRP · Homokysteiini · Bilirubiini · Konjugoitu bilirubiini · PSA · TSH · T4V · Kokonais- ja vapaa testosteroni · SHBG · Folaatti · Magnesium · Tansferriini · Transferriinisaturaatio ja -reseptori · Ferritiini · Fosfaatti · Kokonaisproteiini · Prealbumiini · Virtsan albumiini-kreatiniini -suhde' },
      { name: 'Sydän ja verenkierto', price: '€99', tests: 'Lp(a) · Apolipoproteiinit A1 & B · Herkkä-CRP · Homokysteiini' },
      { name: 'Sydän ja verenkierto, laajennettu', price: '€199', tests: 'Lp(a) · Apolipoproteiinit A1 & B · Herkkä-CRP · Homokysteiini · Keramidit (HERTTA)' },
      { name: 'Ravitsemus', price: '€99', tests: 'CDT · Folaatti · Magnesium · Transferriini · Transferriinisaturaatio ja -reseptori · Ferritiini · T4V · Fosfaatti · Kokonaisproteiini · Pre-albumiini' },
      { name: 'Suorituskyky, miehet', price: '€99', tests: 'T4V · Magnesium · Transferriini · Transferriinisaturaatio ja -reseptori · Kokonais- ja vapaa testosteroni · SHBG · Lasko' },
      { name: 'Suorituskyky, naiset', price: '€99', tests: 'T4V · Magnesium · Transferriini · Transferriinisaturaatio ja -reseptori · FSH · Estradioli · Prolaktiini · Lasko' },
    ].map((pkg, i) => (
      <div class="pkg-accordion" style="background: var(--bg-elevated); border: 1px solid var(--t-15); border-radius: var(--radius-md);">
        <button class="pkg-row" onclick={`togglePkg(${i})`} style="display: flex; justify-content: space-between; align-items: center; width: 100%; background: none; border: none; cursor: pointer; text-align: left;">
          <span style="color: var(--fg-2);">{pkg.name}</span>
          <div style="display: flex; align-items: center; gap: 12px;">
            <span style="font-weight: 600; color: var(--fg-1); white-space: nowrap;">{pkg.price}</span>
            <svg class={`pkg-chevron pkg-chevron-${i}`} width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--fg-3); flex-shrink: 0; transition: transform 0.2s ease;"><polyline points="6 9 12 15 18 9"/></svg>
          </div>
        </button>
        <div class={`pkg-content pkg-content-${i}`} style="display: none; padding: 0 14px 12px; font-size: 11px; color: var(--fg-3); line-height: 1.7;">
          {pkg.tests}
        </div>
      </div>
    ))}
  </div>
</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- JÄSENYYDET -->
<section class="section-ivory">
  <div class="container">
    <div class="text-center fade-up" style="margin-bottom: 64px;">
      <span class="eyebrow">Jäsenyydet</span>
      <h2>Jäsenyys joka vastaa elämäntilannettasi.</h2>
      <p class="lead" style="margin-top: 16px;">Valitse palvelutaso joka sopii juuri sinun tavoitteisiisi ja tarpeisiisi.</p>
    </div>
    <div class="pricing-grid">
      <div class="pricing-card fade-up">
        <div class="pricing-tier">Taso 1</div>
        <div class="price">€99</div>
        <div class="price-label">kuukaudessa</div>
        <ul class="pricing-features">
          <li>Suora yhteys omaan lääkäriin</li>
          <li>Lääkärijohtoinen terveysarvio ja laboratoriopaketti</li>
          <li>1 etävastaanottoaika / kuukausi</li>
          <li>Reseptien uusinnat</li>
        </ul>
        <a href="/fi/contact" class="btn btn-ghost" style="margin-top: auto; margin-left: auto; width: 44px; height: 44px; padding: 0; justify-content: center; border-radius: var(--radius-md);">→</a>
      </div>
      <div class="pricing-card featured fade-up" style="animation-delay: 0.08s">
        <div class="pricing-tier">Taso 2</div>
        <div class="price">€199</div>
        <div class="price-label">kuukaudessa</div>
        <ul class="pricing-features">
          <li>Suora yhteys omaan lääkäriin</li>
          <li>Vuosittainen lääkärijohtoinen terveysarvio ja laboratoriopaketti</li>
          <li>3 etävastaanottoaikaa / kuukausi</li>
          <li>1 lähivastaanottoaika / kuukausi</li>
          <li>Reseptien uusinnat</li>
          <li>Hoidon koordinointi, lähetteet ja ajanvaraukset</li>
        </ul>
        <a href="/fi/contact" class="btn hero-btn-primary" style="margin-top: auto; margin-left: auto; width: 44px; height: 44px; padding: 0; justify-content: center; border-radius: var(--radius-md); background: #FDF6EE; color: #1C1410;">→</a>
      </div>
      <div class="pricing-card fade-up" style="animation-delay: 0.16s">
        <div class="pricing-tier">Taso 3</div>
        <div class="price">€399</div>
        <div class="price-label">kuukaudessa</div>
        <ul class="pricing-features">
          <li>Suora yhteys omaan lääkäriin</li>
          <li>Puolivuosittainen lääkärijohtoinen terveysarvio ja laboratoriopaketti</li>
          <li>5 etävastaanottoaikaa / kuukausi</li>
          <li>3 lähivastaanottoaikaa / kuukausi</li>
          <li>Reseptien uusinnat</li>
          <li>Hoidon koordinointi, lähetteet ja ajanvaraukset</li>
        </ul>
        <a href="/fi/contact" class="btn btn-ghost" style="margin-top: auto; margin-left: auto; width: 44px; height: 44px; padding: 0; justify-content: center; border-radius: var(--radius-md);">→</a>
      </div>
      <div class="pricing-card fade-up" style="animation-delay: 0.24s">
        <div class="pricing-tier">Lapset</div>
        <div class="price">€49</div>
        <div class="price-label">kuukaudessa</div>
        <ul class="pricing-features">
          <li>Suora yhteys omaan lääkäriin</li>
          <li>2 etävastaanottoaikaa / kuukausi</li>
          <li>Reseptien uusinnat</li>
        </ul>
        <a href="/fi/contact" class="btn btn-ghost" style="margin-top: auto; margin-left: auto; width: 44px; height: 44px; padding: 0; justify-content: center; border-radius: var(--radius-md);">→</a>
      </div>
    </div>
  </div>
</section>

<!-- LISÄPALVELUT -->
<section class="section-cream">
  <div class="container">
    <div class="membership-services-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center;">
      <div class="fade-up">
        <div style="margin-bottom: 48px;">
          <span class="eyebrow">Lisäpalvelut</span>
          <h2>Jäsenyyden lisäksi.</h2>
        </div>
        <div style="display: flex; flex-direction: column; gap: 12px;">
          <div class="service-card-inner" style="display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: center; padding: 24px 28px; background: var(--bg-elevated); border: 1px solid var(--t-15); border-radius: var(--radius-lg);">
            <div>
              <h3 style="font-size: var(--h4); margin-bottom: 6px;">Lääkärin ympärivuorokautinen saatavuus</h3>
              <p style="font-size: var(--body-sm); color: var(--fg-3); margin: 0;">Ympärivuorokautinen yhteys, myös viikonloppuisin ja pyhäpäivinä.</p>
            </div>
            <div class="service-card-price" style="text-align: right; flex-shrink: 0;">
              <div style="font-family: var(--font-display); font-size: 1.4rem; color: var(--fg-1);">€899</div>
              <div style="font-size: var(--caption); color: var(--fg-3);">ensimmäinen perheenjäsen</div>
              <div style="font-size: var(--caption); color: var(--fg-3); margin-top: 4px;">€299 toinen perheenjäsen</div>
            </div>
          </div>
          <div class="service-card-inner" style="display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: center; padding: 24px 28px; background: var(--bg-elevated); border: 1px solid var(--t-15); border-radius: var(--radius-lg);">
            <div>
              <h3 style="font-size: var(--h4); margin-bottom: 6px;">Erikoislääkärikäynnit</h3>
              <p style="font-size: var(--body-sm); color: var(--fg-3); margin: 0;">Ulkoiset konsultaatiot, diagnostiikka ja toimenpiteet.</p>
            </div>
            <div class="service-card-price" style="text-align: right; flex-shrink: 0;">
              <div style="font-size: var(--caption); color: var(--fg-3);">Laskutetaan kumppanin <br/>hinnaston mukaan.</div>
            </div>
          </div>
          <div class="service-card-inner" style="display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: center; padding: 24px 28px; background: var(--bg-elevated); border: 1px solid var(--t-15); border-radius: var(--radius-lg);">
            <div>
              <h3 style="font-size: var(--h4); margin-bottom: 6px;">Lääkärin ja hoitajan kotikäynnit</h3>
              <p style="font-size: var(--body-sm); color: var(--fg-3); margin: 0;">Lääkärisi tai hoitajasi tulee luoksesi - kotiin, toimistolle tai muualle tarpeittesi mukaan.</p>
            </div>
            <div class="service-card-price" style="text-align: right; flex-shrink: 0;">
              <div style="font-size: var(--caption); color: var(--fg-3);">Laskutetaan Foundation <br/>Clinicin hinnaston mukaan.</div>
            </div>
          </div>
        </div>
        <div style="margin-top: 28px;">
          <button onclick="openPriceDrawer()" class="btn btn-outline">Hinnastomme →</button>
        </div>
      </div>
      <div class="fade-up membership-services-image" style="overflow: hidden; border-radius: var(--radius-lg); height: 520px;">
        <img src="https://cdn.prod.website-files.com/67812a141d8f2465fe6175eb/69c11723fbd8abfea21d153a_031354cd315326fa864ff8e5f33fe118_foundation-clinic-approach2.webp" alt="Foundation Clinic" style="width: 100%; height: 100%; object-fit: cover;" />
      </div>
    </div>
  </div>
</section>

<section class="tailored-cta" style="position: relative; min-height: 400px; display: flex; align-items: center; justify-content: center; text-align: center; margin: 0 calc(-1 * var(--s-8)); padding: var(--s-24) var(--s-8);">
  <div style="position: absolute; inset: 0; background-image: url('/assets/images/hikers-mountain-trail.jpg'); background-size: cover; background-position: center 85%;"></div>
  <div style="position: absolute; inset: 0; background: rgba(46,31,20,0.55);"></div>
  <div style="position: relative; z-index: 1; max-width: 560px;">
    <span class="eyebrow" style="color: rgba(255,255,255,0.6);">Räätälöity jäsenyys</span>
    <h2 style="color: var(--cream);">Etsitkö jotain muuta?</h2>
    <p style="margin-top: 16px; margin-bottom: 32px; color: rgba(253,246,238,0.75);">Räätälöimme mielellämme jäsenyyden juuri sinulle. Ota yhteyttä ja keskustellaan tarkemmin tilanteestasi ja tarpeistasi.</p>
    <a href="/fi/contact" class="btn btn-primary" style="background: var(--cream); color: var(--espresso);">Ota yhteyttä</a>
  </div>
</section>

<!-- HINNASTO-DRAWER -->
<div class="price-drawer-overlay" id="priceDrawerOverlay" onclick="closePriceDrawer()"></div>
<div class="price-drawer" id="priceDrawer">
  <div class="price-drawer-header">
    <div style="display: flex; align-items: center; gap: 12px;">
      <h2>Hinnasto</h2>
      <a href="/assets/docs/Foundation-Clinic-Price-List.pdf" download style="display: flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 500; color: var(--fg-3); font-family: 'Plus Jakarta Sans', sans-serif; text-decoration: none; margin-top: 2px;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Lataa PDF
      </a>
    </div>
    <button class="price-drawer-close" onclick="closePriceDrawer()">✕</button>
  </div>
  <div class="price-drawer-body">

<div class="drawer-section">
  <button class="drawer-section-btn" onclick="toggleSection(this)">
    Jäsenyydet
    <svg class="drawer-section-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
  </button>
  <div class="drawer-section-content">
    <div class="drawer-row"><span class="drawer-row-label">Alkukartoitus</span><span class="drawer-row-price">€599</span></div>
    <div class="drawer-row"><span class="drawer-row-label">Taso 1</span><span class="drawer-row-price">€99 / kk</span></div>
    <div class="drawer-row"><span class="drawer-row-label">Taso 2</span><span class="drawer-row-price">€199 / kk</span></div>
    <div class="drawer-row"><span class="drawer-row-label">Taso 3</span><span class="drawer-row-price">€399 / kk</span></div>
    <div class="drawer-row"><span class="drawer-row-label">Lapset</span><span class="drawer-row-price">€49 / kk</span></div>
  </div>
</div>

<div class="drawer-section">
