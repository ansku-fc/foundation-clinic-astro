---
import Base from '../../layouts/Base.astro';
---
<Base title="Ota yhteyttä" lang="fi">

  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Ota yhteyttä</span>
      <h1>Ota yhteyttä – me hoidamme loput.</h1>
      <p class="lead" style="margin-top: 16px;">Vastaamme kaikkiin sähköposteihin vuorokaudessa.</p>
    </div>
  </section>

  <section class="section-ivory">
    <div class="container">
      <div class="split fade-up">
        <div>
          <span class="eyebrow">Lähetä viesti</span>
          <h2 style="margin-bottom: 32px;">Otetaan yhteyttä.</h2>
          <form class="contact-form" action="https://formspree.io/f/hello@foundation.clinic" method="POST">
            <div class="form-row">
              <div class="form-group">
                <label for="first-name">Etunimi</label>
                <input type="text" id="first-name" name="first_name" placeholder="Anna" required />
              </div>
              <div class="form-group">
                <label for="last-name">Sukunimi</label>
                <input type="text" id="last-name" name="last_name" placeholder="Virtanen" required />
              </div>
            </div>
            <div class="form-group">
              <label for="email">Sähköposti</label>
              <input type="email" id="email" name="email" placeholder="anna@esimerkki.fi" required />
            </div>
            <div class="form-group">
              <label for="phone">Puhelin (valinnainen)</label>
              <input type="tel" id="phone" name="phone" placeholder="+358 40 123 4567" />
            </div>
            <div class="form-group">
              <label for="interest">Olen kiinnostunut</label>
              <select id="interest" name="interest">
                <option value="">Valitse vaihtoehto</option>
                <option value="membership">Jäseneksi liittymisestä</option>
                <option value="family">Perhejäsenyydestä</option>
                <option value="corporate">Yritysyhteistyöstä</option>
                <option value="other">Muusta</option>
              </select>
            </div>
            <div class="form-group">
              <label for="message">Viesti</label>
              <textarea id="message" name="message" placeholder="Kerro meille, mitä etsit..."></textarea>
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">Lähetä viesti</button>
            <p style="font-size: var(--caption); color: var(--fg-3); margin-top: 12px; text-align: center;">Vastaamme sinulle 24 tunnin sisällä.</p>
          </form>
        </div>
        <div style="display: flex; flex-direction: column; gap: 16px;">
          <span class="eyebrow">Yhteystiedot</span>
          <div style="padding: 20px 24px; background: var(--bg-surface); border: 1px solid var(--t-15); border-radius: var(--radius-lg);">
            <p style="font-size: var(--caption); font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--fg-3); margin-bottom: 6px;">Sähköposti</p>
            <a href="mailto:hello@foundation.clinic" style="font-size: var(--body); color: var(--teal); font-weight: 500;">hello@foundation.clinic</a>
          </div>
          <div style="padding: 20px 24px; background: var(--bg-surface); border: 1px solid var(--t-15); border-radius: var(--radius-lg);">
            <p style="font-size: var(--caption); font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--fg-3); margin-bottom: 6px;">Puhelin</p>
            <a href="tel:+358407268383" style="font-size: var(--body); color: var(--fg-1); font-weight: 500;">+358 40 726 8383</a>
          </div>
          <div style="padding: 20px 24px; background: var(--bg-surface); border: 1px solid var(--t-15); border-radius: var(--radius-lg);">
            <p style="font-size: var(--caption); font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--fg-3); margin-bottom: 6px;">Osoite</p>
            <p style="font-size: var(--body); color: var(--fg-1);">Ratakatu 29 a 4<br>00120 Helsinki</p>
          </div>
          <div style="padding: 20px 24px; background: var(--bg-surface); border: 1px solid var(--t-15); border-radius: var(--radius-lg);">
            <p style="font-size: var(--caption); font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--fg-3); margin-bottom: 6px;">Aukioloajat</p>
            <p style="font-size: var(--body); color: var(--fg-1);">Maanantai–Perjantai<br>9:00–17:00</p>
          </div>
        </div>
      </div>
    </div>
  </section>

</Base>