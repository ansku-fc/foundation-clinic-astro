---
import Base from '../../layouts/Base.astro';
---
<Base title="Kumppanit" description="Yhteistyössä paremman hoidon puolesta." lang="fi">

<section class="hero-subpage">
    <div class="hero-bg" style="background-image: url('https://cdn.prod.website-files.com/67812a141d8f2465fe6175eb/69d6375ea03a61d5a2486655_artem-kovalev-fk3XUcfTAvk-unsplash.jpg');"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <span class="hero-eyebrow">Kumppanit</span>
      <h1 class="hero-headline">Yhteistyötä paremman hoidon puolesta.</h1>
      <p class="hero-lead">Teemme yhteistyötä organisaatioiden kanssa, jotka jakavat sitoutumisemme pitkäjänteiseen terveyteen ja elämänlaatuun.</p>
    </div>
  </section>

  <section class="section-ivory">
    <div class="container">
      <div class="max-prose fade-up">
        <p style="font-size: var(--body-lg); color: var(--fg-1); line-height: 1.7;">Foundation Clinic tekee yhteistyötä valikoitujen kumppaneiden kanssa tarjotakseen jäsenilleen pääsyn parhaaseen mahdolliseen hoitoon ja palveluihin.</p>
        <p style="margin-top: 20px;">Jos olet kiinnostunut kumppanuudesta kanssamme, ota yhteyttä.</p>
        <a href="/fi/contact" class="btn btn-primary" style="margin-top: 32px;">Ota yhteyttä</a>
      </div>
    </div>
  </section>

</Base>