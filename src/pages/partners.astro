---
import Base from '../layouts/Base.astro';
---
<Base title="Partners" description="Working together for better care.">

  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Partners</span>
      <h1>Working together<br>for better care.</h1>
      <p class="lead" style="margin-top: 16px;">We partner with organisations that share our commitment to long-term health and quality of life.</p>
    </div>
  </section>

  <section class="section-ivory">
    <div class="container">
      <div class="max-prose fade-up">
        <p style="font-size: var(--body-lg); color: var(--fg-1); line-height: 1.7;">Foundation Clinic works with select partners to offer our members access to the best possible care and services.</p>
        <p style="margin-top: 20px;">If you are interested in partnering with us, please get in touch.</p>
        <a href="/contact" class="btn btn-primary" style="margin-top: 32px;">Get in touch</a>
      </div>
    </div>
  </section>

  <section class="section-espresso">
    <div class="container">
      <div class="text-center fade-up" style="max-width: 600px; margin: 0 auto;">
        <h2>Interested in partnering with Foundation Clinic?</h2>
        <p style="margin-top: 16px; margin-bottom: 32px;">We answer all emails within 24 hours.</p>
        <a href="/contact" class="btn" style="background: var(--cream); color: var(--espresso);">Contact us</a>
      </div>
    </div>
  </section>

</Base>