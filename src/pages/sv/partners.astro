---
import Base from '../../layouts/Base.astro';
---
<Base title="Partners" description="Tillsammans för bättre vård." lang="sv">

<section class="hero-subpage">
    <div class="hero-bg" style="background-image: url('https://cdn.prod.website-files.com/67812a141d8f2465fe6175eb/69d6375ea03a61d5a2486655_artem-kovalev-fk3XUcfTAvk-unsplash.jpg');"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <span class="hero-eyebrow">Partners</span>
      <h1 class="hero-headline">Tillsammans<br>för bättre vård.</h1>
      <p class="hero-lead">Vi samarbetar med organisationer som delar vårt engagemang för långsiktig hälsa och livskvalitet.</p>
    </div>
  </section>

  <section class="section-ivory">
    <div class="container">
      <div class="max-prose fade-up">
        <p style="font-size: var(--body-lg); color: var(--fg-1); line-height: 1.7;">Foundation Clinic samarbetar med utvalda partners för att ge våra medlemmar tillgång till bästa möjliga vård och tjänster.</p>
        <p style="margin-top: 20px;">Om du är intresserad av ett samarbete med oss, hör gärna av dig.</p>
        <a href="/sv/contact" class="btn btn-primary" style="margin-top: 32px;">Kontakta oss</a>
      </div>
    </div>
  </section>

</Base>