---
import Base from '../../layouts/Base.astro';
---
<Base title="About Us" description="Meet the Foundation Clinic team.">

<style is:global>
    .hero-subpage .hero-overlay {
      background: linear-gradient(to top, rgba(46,31,20,0.97) 0%, rgba(46,31,20,0.65) 50%, rgba(46,31,20,0.25) 100%);
    }

    .what-card {
      padding-top: var(--s-8) !important;
    }
  </style>
  
  <section class="hero-subpage">
    <div class="hero-bg" style="background-image: url('/assets/images/beach-runner.jpg'); background-position: right 90%;"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <span class="hero-eyebrow">About us</span>
      <h1 class="hero-headline">Healthcare as it should be.</h1>
      <p class="hero-lead">Founded to challenge the status quo.</p>
    </div>
  </section>

  <section class="section-ivory">
    <div class="container">
      <div class="split fade-up">
        <div class="split-image">
         <img src="/assets/images/pears-on-plate.jpg"/>
        </div>
        <div class="split-content">
          <span class="eyebrow">Our story</span>
          <h2>We're in it for the long term.</h2>
          <p style="margin-top: 16px;">Modern medicine revolves around short appointments, scattered records and rotating providers. We saw a need for something more human and more effective.</p>
          <p style="margin-top: 16px;">Healthcare shouldn't just react to symptoms, but build long-term insight, trust and continuity.</p>
        </div>
      </div>
    </div>
  </section>

<section class="section-sunken">
  <div class="container">
    <div class="fade-up" style="margin-bottom: 48px;">
      <span class="eyebrow">The team</span>
      <h2>Meet the people behind Foundation Clinic.</h2>
    </div>
    <div class="team-grid">
      <div class="team-card fade-up">
        <img class="team-photo" src="https://cdn.prod.website-files.com/67812a141d8f2465fe6175eb/67f7bb0b937aef6c9121eb7a_FoundationClinic_web_Anni-3.webp" alt="Enni Sanmark" style="object-position: top;" />
        <div class="team-name">MD PhD Enni Sanmark</div>
        <div class="team-role">Chief Medical Officer</div>
        <a href="mailto:enni@foundation.clinic" class="team-email">enni@foundation.clinic</a>
      </div>
      <div class="team-card fade-up" style="animation-delay: 0.18s">
        <img class="team-photo" src="https://cdn.prod.website-files.com/67812a141d8f2465fe6175eb/67f7bb0c86cd56abba4c14bc_FoundationClinic_web_Anni.webp" alt="Anni Karjala" style="object-position: top;" />
        <div class="team-name">MD PhD Anni Karjala</div>
        <div class="team-role">Head of Foundation Protocol</div>
        <a href="mailto:anni@foundation.clinic" class="team-email">anni@foundation.clinic</a>
      </div>
      <div class="team-card fade-up" style="animation-delay: 0.24s">
        <img class="team-photo" src="https://cdn.prod.website-files.com/67812a141d8f2465fe6175eb/690ba48c4a48b7522465a82a_Eevert.webp" alt="Eevert Partinen" style="object-position: top;" />
        <div class="team-name">MD Eevert Partinen</div>
        <div class="team-role">GP, Sleep Expert</div>
        <a href="mailto:eevert@foundation.clinic" class="team-email">eevert@foundation.clinic</a>
      </div>
      <div class="team-card fade-up" style="animation-delay: 0.30s">
        <img class="team-photo" src="https://cdn.prod.website-files.com/67812a141d8f2465fe6175eb/6994db3765b46e9bd63bc049_Runo.webp" alt="Runo Pyykönen" style="object-position: top;" />
        <div class="team-name">Runo Pyykönen</div>
        <div class="team-role">Head Nurse</div>
        <a href="mailto:runo@foundation.clinic" class="team-email">runo@foundation.clinic</a>
      </div>
      <div class="team-card fade-up" style="animation-delay: 0.06s">
        <img class="team-photo" src="https://cdn.prod.website-files.com/67812a141d8f2465fe6175eb/67f7bb0ca734cbad06b19b50_FoundationClinic_web_Anni-1.webp" alt="Antti Ylimutka" style="object-position: top;" />
        <div class="team-name">Antti Ylimutka</div>
        <div class="team-role">Chief Executive Officer</div>
        <a href="mailto:antti@foundation.clinic" class="team-email">antti@foundation.clinic</a>
      </div>
      <div class="team-card fade-up" style="animation-delay: 0.12s">
        <img class="team-photo" src="https://cdn.prod.website-files.com/67812a141d8f2465fe6175eb/6994da8f1b90dd85b4511d47_Fredrik.webp" alt="Fredrik Sannholm" style="object-position: top;" />
        <div class="team-name">Fredrik Sannholm</div>
        <div class="team-role">Principal Engineer</div>
        <a href="mailto:fredrik@foundation.clinic" class="team-email">fredrik@foundation.clinic</a>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
  <section class="cta-fullbleed">
    <div class="cta-bg" style="background-image: url('/assets/images/river-evening.jpg'); background-size: cover; background-position: center;"></div>
    <div class="cta-overlay"></div>
    <div class="container cta-content fade-up">
      <div style="max-width: 1000px; margin: 0 auto; text-align: center;">
        <h2>Contact us to explore how we can support your long-term health.</h2>
        <p style="margin-top: 16px; margin-bottom: 32px;">We answer all emails within 24 hours.</p>
        <a href="/en/contact" class="btn" style="background: var(--cream); color: var(--espresso);">Contact Us</a>
      </div>
    </div>
  </section>

</Base>