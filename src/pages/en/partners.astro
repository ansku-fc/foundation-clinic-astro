---
import Base from '../../layouts/Base.astro';
---
<Base title="Partners" description="Working together for better care.">

<section class="hero-subpage">
    <div class="hero-bg" style="background-image: url('https://cdn.prod.website-files.com/67812a141d8f2465fe6175eb/69d6375ea03a61d5a2486655_artem-kovalev-fk3XUcfTAvk-unsplash.jpg');"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <span class="hero-eyebrow">Partners</span>
      <h1 class="hero-headline">Working together<br>for better care.</h1>
      <p class="hero-lead">We partner with organisations that share our commitment to long-term health and quality of life.</p>
    </div>
  </section>

  <section class="section-ivory">
    <div class="container">
      <div class="max-prose fade-up">
        <p style="font-size: var(--body-lg); color: var(--fg-1); line-height: 1.7;">Foundation Clinic works with select partners to offer our members access to the best possible care and services.</p>
        <p style="margin-top: 20px;">If you are interested in partnering with us, please get in touch.</p>
        <a href="/en/contact" class="btn btn-primary" style="margin-top: 32px;">Get in touch</a>
      </div>
    </div>
  </section>

</Base>