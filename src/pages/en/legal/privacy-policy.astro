---
import Base from '../../../layouts/Base.astro';
---
<Base title="Privacy Policy" description="Our privacy notices explain how we collect, use, and protect your personal data.">

  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Legal</span>
      <h1>Privacy policy</h1>
      <p class="lead" style="margin-top: 16px;">Our privacy notices explain how we collect, use, and protect your personal data.</p>
    </div>
  </section>

  <section class="section-ivory">
    <div class="container">
      <div class="legal-body fade-up">
        <p>Foundation Health Finland Oy is committed to protecting the privacy and confidentiality of your personal data. As a registered healthcare provider, we process personal data in strict accordance with the EU General Data Protection Regulation (GDPR), the Finnish Data Protection Act, and healthcare-specific legislation.</p>
        <p>Our privacy practices are set out in the following notices:</p>
        <div style="margin-top: 40px;">
          <a href="/en/legal/privacy-notice-for-patient-records" class="legal-link-card">
            <div>
              <div class="legal-link-card-title">Privacy Notice for Patient Records</div>
              <div style="font-size: var(--body-sm); color: var(--fg-3); margin-top: 4px;">How we process your medical records and health data</div>
            </div>
            <span style="color: var(--fg-3);">→</span>
          </a>
          <a href="/en/legal/privacy-notice-for-personal-data" class="legal-link-card">
            <div>
              <div class="legal-link-card-title">Privacy Notice for Personal Data</div>
              <div style="font-size: var(--body-sm); color: var(--fg-3); margin-top: 4px;">How we process your personal data as a member or contact</div>
            </div>
            <span style="color: var(--fg-3);">→</span>
          </a>
          <a href="/en/legal/customer-register-privacy-notice" class="legal-link-card">
            <div>
              <div class="legal-link-card-title">Customer Register Privacy Notice</div>
              <div style="font-size: var(--body-sm); color: var(--fg-3); margin-top: 4px;">How we maintain and use our customer register</div>
            </div>
            <span style="color: var(--fg-3);">→</span>
          </a>
        </div>
        <p style="margin-top: 40px; font-size: var(--body-sm); color: var(--fg-3);">For any questions regarding your data, please contact us at <a href="mailto:hello@foundation.clinic">hello@foundation.clinic</a>.</p>
      </div>
    </div>
  </section>

</Base>