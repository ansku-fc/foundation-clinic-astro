---
import Base from '../../layouts/Base.astro';
---
<Base title="Personal Medical Care" description="Dedicated medical care, tailored to you.">

  <!-- HERO -->
  <section class="hero-fullbleed">
    <div class="hero-bg" style="background-image: url('/assets/images/hero-bg.jpg');"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="hero-eyebrow">Ratakatu 29 a 4 · Helsinki</p>
      <h1 class="hero-headline">Your personal doctor<br>who knows you by name.</h1>
      <p class="hero-lead">Personalised, high-quality, and prevention-first care. Always available, in Finland and abroad.</p>
      <div class="hero-cta">
  <a href="/en/contact" class="btn hero-btn-primary" style="padding: 10px 18px; font-size: 13px;">Join Foundation</a>
  <a href="/en/our-approach" class="btn hero-btn-outline" style="padding: 10px 18px; font-size: 13px;">How it works</a>
</div>
    </div>
  </section>

  <!-- WHO WE ARE -->
  <section style="background: var(--ivory); padding: 0;">
    <div class="who-we-are">
      <div class="who-we-are-image">
        <img src="/assets/images/stilllife-figs.jpg" alt="Foundation Clinic" />
      </div>
      <div class="who-we-are-content fade-up">
        <span class="eyebrow">Who we are</span>
        <h2 style="margin-top: 0;">We take full responsibility of your health.</h2>
        <p>We provide healthcare as it should be.</p>
        <div class="who-we-are-cards">
          <div class="who-card">
            <h4>Monthly membership</h4>
            <p>Direct access to your personal doctor, in Finland and abroad.</p>
          </div>
          <div class="who-card">
            <h4>Coordinated care</h4>
            <p>Acute care, specialist referrals and diagnostics seamlessly through us.</p>
          </div>
          <div class="who-card">
            <h4>Easy access</h4>
            <p>Appointments at the clinic, at home, or through our network abroad.</p>
          </div>
          <div class="who-card">
            <h4>Data-driven health</h4>
            <p>Your history, results and treatments in one continuous health record.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT WE DO -->
  <section class="section-sunken" style="padding-top: var(--s-20); padding-bottom: var(--s-20);">
    <div class="container">
      <div class="fade-up" style="margin-bottom: 56px;">
        <span class="eyebrow">What we do</span>
        <h2 style="margin-top: 0;">Health for your whole life.</h2>
        <p class="lead" style="margin-top: 16px;">Whether you're managing a condition, optimizing your health, or raising a family - your doctor is there for all of it.</p>
      </div>
      <div class="what-grid">
        <div class="what-card fade-up">
          <div class="what-card-image">
            <img src="/assets/images/open-water-swimmers.jpg" alt="Performance & prevention" />
          </div>
          <span class="eyebrow">01</span>
          <h3 style="white-space: nowrap;">Performance &amp; Prevention</h3>
          <p>Through regular consultations, laboratory testing, and ongoing monitoring, we identify early changes and manage risks proactively.</p>
          <a href="/en/our-services" class="btn btn-ghost" style="margin-top: auto; margin-left: auto; width: 44px; height: 44px; padding: 0; justify-content: center; border-radius: var(--radius-md);">→</a>
        </div>
        <div class="what-card fade-up" style="animation-delay: 0.08s">
          <div class="what-card-image">
            <img src="/assets/images/elderly-man-profile-sunset.jpg" alt="Healthy aging" />
          </div>
          <span class="eyebrow">02</span>
          <h3>Healthy Aging</h3>
          <p>Health needs often become more complex with age. Your doctor acts as the main point of contact, ensuring your care remains clear and consistent.</p>
          <a href="/en/our-services" class="btn btn-ghost" style="margin-top: auto; margin-left: auto; width: 44px; height: 44px; padding: 0; justify-content: center; border-radius: var(--radius-md);">→</a>
        </div>
        <div class="what-card fade-up" style="animation-delay: 0.16s">
          <div class="what-card-image">
            <img src="/assets/images/child-arm-bandaids.jpg" alt="Children & families" />
          </div>
          <span class="eyebrow">03</span>
          <h3>Children &amp; Families</h3>
          <p>We support families with both preventive care and everyday medical concerns, complementing Finland's neuvola system with continuous personal care.</p>
          <a href="/en/our-services" class="btn btn-ghost" style="margin-top: auto; margin-left: auto; width: 44px; height: 44px; padding: 0; justify-content: center; border-radius: var(--radius-md);">→</a>
        </div>
        <div class="what-card fade-up" style="animation-delay: 0.24s">
          <div class="what-card-image">
            <img src="/assets/images/woman-coast-sunset.jpg" alt="Complex health needs" />
          </div>
          <span class="eyebrow">04</span>
          <h3>Complex Health Needs</h3>
          <p>For patients managing chronic conditions or navigating specialist care, we provide coordination, continuity, and a doctor who knows the full picture.</p>
          <a href="/en/our-services" class="btn btn-ghost" style="margin-top: auto; margin-left: auto; width: 44px; height: 44px; padding: 0; justify-content: center; border-radius: var(--radius-md);">→</a>
        </div>
      </div>
    </div>
  </section>

<!-- MEMBERSHIPS -->
  <section class="section-ivory">
    <div class="container">
      <div class="text-center fade-up" style="margin-bottom: 64px;">
        <span class="eyebrow">Memberships</span>
        <h2>Your most important subscription.</h2>
      </div>
      <div class="pricing-grid">
        <div class="pricing-card fade-up">
          <div class="pricing-tier">Tier 1</div>
          <div class="price">€99</div>
          <div class="price-label">per month</div>
          <ul class="pricing-features">
            <li>Direct access to personal doctor</li>
            <li>1 remote appointment / month</li>
            <li>Prescription renewals</li>
          </ul>
          <a href="/en/contact" class="btn btn-ghost" style="margin-top: auto; margin-left: auto; width: 44px; height: 44px; padding: 0; justify-content: center; border-radius: var(--radius-md);">→</a>
        </div>
        <div class="pricing-card featured fade-up" style="animation-delay: 0.08s">
          <div class="pricing-tier">Tier 2</div>
          <div class="price">€199</div>
          <div class="price-label">per month</div>
          <ul class="pricing-features">
            <li>Direct access to personal doctor</li>
            <li>Annual doctor-led health assessment with laboratory panel</li>
            <li>3 remote appointments / month</li>
            <li>1 in-person appointment / month</li>
            <li>Prescription renewals</li>
            <li>Care coordination, referrals & scheduling</li>
          </ul>
          <a href="/en/contact" class="btn hero-btn-primary" style="margin-top: auto; margin-left: auto; width: 44px; height: 44px; padding: 0; justify-content: center; border-radius: var(--radius-md); background: #FDF6EE; color: #1C1410;">→</a>
        </div>
        <div class="pricing-card fade-up" style="animation-delay: 0.16s">
          <div class="pricing-tier">Tier 3</div>
          <div class="price">€399</div>
          <div class="price-label">per month</div>
          <ul class="pricing-features">
            <li>Direct access to personal doctor</li>
            <li>Bi-annual doctor-led health assessment with laboratory panel</li>
            <li>5 remote appointments / month</li>
            <li>3 in-person appointments / month</li>
            <li>Prescription renewals</li>
            <li>Care coordination, referrals & scheduling</li>
          </ul>
          <a href="/en/contact" class="btn btn-ghost" style="margin-top: auto; margin-left: auto; width: 44px; height: 44px; padding: 0; justify-content: center; border-radius: var(--radius-md);">→</a>
        </div>
        <div class="pricing-card fade-up" style="animation-delay: 0.24s">
          <div class="pricing-tier">Children</div>
          <div class="price">€49</div>
          <div class="price-label">per month</div>
          <ul class="pricing-features">
            <li>Direct access to personal doctor</li>
            <li>2 remote appointments / month</li>
            <li>Prescription renewals</li>
          </ul>
          <a href="/en/contact" class="btn btn-ghost" style="margin-top: auto; margin-left: auto; width: 44px; height: 44px; padding: 0; justify-content: center; border-radius: var(--radius-md);">→</a>
        </div>
      </div>
      <p style="font-size: var(--body-sm); color: var(--fg-3); margin-top: 24px; text-align: center;"><a href="/en/memberships" style="color: var(--fg-2); text-decoration: underline;">Full pricing →</a></p>
    </div>
  </section>

<!-- CTA -->
  <section class="cta-fullbleed">
    <div class="cta-bg" style="background-image: url('/assets/images/river-evening.jpg'); background-size: cover; background-position: center;"></div>
    <div class="cta-overlay"></div>
    <div class="container cta-content fade-up">
      <div style="max-width: 1000px; margin: 0 auto; text-align: center;">
        <h2>Contact us to explore how we can support your long-term health.</h2>
        <p style="margin-top: 16px; margin-bottom: 32px;">We answer all emails within 24 hours.</p>
        <a href="/en/contact" class="btn" style="background: var(--cream); color: var(--espresso);">Contact Us</a>
      </div>
    </div>
  </section>

</Base>