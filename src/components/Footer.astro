---
const { lang = 'en' } = Astro.props;
const base = lang === 'fi' ? '/fi' : lang === 'sv' ? '/sv' : '/en';
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <img src="/assets/images/foundation-clinic-icon-white.png" alt="Foundation Clinic" style="height: 44px; width: auto;" />
      </div>
      <div>
        <div class="footer-heading">{ lang === 'fi' ? 'Hoito' : lang === 'sv' ? 'Vård' : 'Care' }</div>
        <ul class="footer-links">
          <li><a href={`${base}/our-approach`}>{ lang === 'fi' ? 'Toimintatapamme' : lang === 'sv' ? 'Förhållningssätt' : 'Our approach' }</a></li>
          <li><a href={`${base}/our-services`}>{ lang === 'fi' ? 'Palvelumme' : lang === 'sv' ? 'Tjänster' : 'Services' }</a></li>
          <li><a href={`${base}/memberships`}>{ lang === 'fi' ? 'Jäsenyydet' : lang === 'sv' ? 'Medlemskap' : 'Memberships' }</a></li>
          <li><a href={`${base}/partners`}>{ lang === 'fi' ? 'Yhteistyökumppanit' : lang === 'sv' ? 'Partners' : 'Partners' }</a></li>
        </ul>
      </div>
      <div>
        <div class="footer-heading">{ lang === 'fi' ? 'Klinikka' : lang === 'sv' ? 'Klinik' : 'Clinic' }</div>
        <ul class="footer-links">
          <li><a href={`${base}/about-us`}>{ lang === 'fi' ? 'Tietoa meistä' : lang === 'sv' ? 'Om oss' : 'About us' }</a></li>
          <li><a href={`${base}/contact`}>{ lang === 'fi' ? 'Ota yhteyttä' : lang === 'sv' ? 'Kontakta oss' : 'Contact' }</a></li>
        </ul>
      </div>
      <div>
        <div class="footer-heading">{ lang === 'fi' ? 'Yhteystiedot' : lang === 'sv' ? 'Kontakt' : 'Contact' }</div>
        <ul class="footer-links">
          <li><a href="mailto:hello@foundation.clinic">hello@foundation.clinic</a></li>
          <li><a href="tel:+358449025885">+358 44 902 5885</a></li>
          <li style="color: var(--t-50); font-size: var(--body-sm); margin-top: 8px;">Ratakatu 29 a 4<br>00120 Helsinki</li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span class="footer-copy">© 2026 Foundation Clinic. { lang === 'fi' ? 'Kaikki oikeudet pidätetään.' : lang === 'sv' ? 'Alla rättigheter reserverade.' : 'All rights reserved.' }</span>
      <div class="footer-legal">
        <a href={`${base}/legal/privacy-policy`}>{ lang === 'fi' ? 'Tietosuojakäytännöt' : lang === 'sv' ? 'Sekretesspolicy' : 'Privacy policy' }</a>
        <a href={`${base}/legal/terms-of-service`}>{ lang === 'fi' ? 'Käyttöehdot' : lang === 'sv' ? 'Användarvillkor' : 'Terms of service' }</a>
      </div>
    </div>
  </div>
</footer>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
</script>